# ~/.config/mnemosyne/run.env, read by mnemosyne-scheduled (a shell file: no spaces in paths).
# Two repositories on two different disks: if one disk dies, the other still has everything.
MNEMOSYNE_REPOS="$HOME/Mnemosyne /media/backup-disk/Mnemosyne"
MNEMOSYNE_PATHS="$HOME/Documents $HOME/Pictures $HOME/projects"
MNEMOSYNE_PASSWORD_FILE="$HOME/.config/mnemosyne/password"
MNEMOSYNE_EXCLUDE_FILE="$HOME/.config/mnemosyne/excludes"
# Keep rules for the daily maintenance, and how much data it re-reads and verifies.
MNEMOSYNE_KEEP="--keep-last 24 --keep-daily 7 --keep-weekly 8 --keep-monthly 12"
MNEMOSYNE_CHECK_PERCENT=10
